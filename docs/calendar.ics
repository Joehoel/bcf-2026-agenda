BEGIN:VEVENT
UID:depart-nl@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Autorit: Apeldoorn → Calais
DTSTART;TZID=Europe/Amsterdam:20260825T060000
DTEND;TZID=Europe/Amsterdam:20260825T103500
LOCATION:Apeldoorn → Port de Calais\, 62100 Calais\, Frankrijk
DESCRIPTION:Routeberekening: circa 390 km en 4 uur 34 minuten zonder stop
 s of vertraging. Vertrek om 06:00 is het veilige voorstel: mik op aankom
 st uiterlijk 11:20 (twee uur voor vertrek)\; de uiterste voertuigcheck-i
 n is 12:20. Vertrek om 08:00 is te laat: zelfs zonder pauze kom je pas r
 ond 12:34 aan.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:ferry-out@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:P&O Ferry: Calais → Dover
DTSTART;TZID=Europe/Paris:20260825T132000
DTEND;TZID=Europe/London:20260825T135000
LOCATION:Port de Calais → Port of Dover
DESCRIPTION:Boekingstijden. Engeland is één uur vroeger\; de overtocht 
 duurt feitelijk 1 uur 30 minuten. Zorg voor ruime marge voor grenscontro
 le en check-in.
END:VEVENT
BEGIN:VEVENT
UID:green-acres-stay@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Voorvakantie op Camping Green Acres
DTSTART;VALUE=DATE:20260825
DTEND;VALUE=DATE:20260828
LOCATION:Green Acres Farm Certificated Site\, Three Acres\, Sandy Lane\, 
 Horspath\, Oxford OX33 1TF\, Verenigd Koninkrijk
DESCRIPTION:Drie nachten. Inchecken volgens de boekingsinformatie tussen 
 14:00 en 20:00. Programma bewust ontspannen en grotendeels open.
END:VEVENT
BEGIN:VEVENT
UID:green-acres-arrival@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Autorit: Dover → Green Acres
DTSTART;TZID=Europe/London:20260825T142000
DTEND;TZID=Europe/London:20260825T170000
LOCATION:Port of Dover → Three Acres\, Sandy Lane\, Horspath\, Oxford O
 X33 1TF
DESCRIPTION:Routeberekening: circa 224 km en 2 uur 38 minuten zonder stop
 s of vertraging. Starttijd rekent ongeveer 30 minuten voor ontschepen in
  Dover\; verwachte aankomst rond 17:00.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:green-acres-setup@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Aankomst en tenten opzetten bij Green Acres
DTSTART;TZID=Europe/London:20260825T170000
DTEND;TZID=Europe/London:20260825T183000
LOCATION:Green Acres Farm Certificated Site\, Three Acres\, Sandy Lane\, 
 Horspath\, Oxford OX33 1TF\, Verenigd Koninkrijk
DESCRIPTION:Geschatte aankomst op basis van de route vanaf Dover. De oors
 pronkelijke groepsinformatie noemt inchecken tussen 14:00 en 20:00.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:green-acres-pack@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Tenten afbreken en Green Acres verlaten
DTSTART;TZID=Europe/London:20260828T073000
DTEND;TZID=Europe/London:20260828T090000
LOCATION:Green Acres Farm Certificated Site\, Three Acres\, Sandy Lane\, 
 Horspath\, Oxford OX33 1TF\, Verenigd Koninkrijk
DESCRIPTION:Voorlopig tijdvak om twee tenten en alle kampeerspullen in te
  pakken vóór de rit naar Big Church Festival.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:bcf-travel@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Autorit: Green Acres → Big Church Festival
DTSTART;TZID=Europe/London:20260828T090000
DTEND;TZID=Europe/London:20260828T110000
LOCATION:Three Acres\, Sandy Lane\, Horspath\, Oxford OX33 1TF → Wiston
  Estate\, Steyning BN44 3DD
DESCRIPTION:Routeberekening: circa 149 km en 2 uur zonder stops of vertra
 ging. Campingingang Big Church via Green Gate\; volg bij aankomst de eve
 nementborden.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:bcf-friday@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Big Church Festival — vrijdag
DTSTART;TZID=Europe/London:20260828T123000
DTEND;TZID=Europe/London:20260828T221500
LOCATION:Wiston Estate\, Steyning\, BN44 3DD
DESCRIPTION:Officieel: poorten voor iedereen en terrein open 10:00\, podi
 a vanaf 12:30\, Main Stage klaar 22:15\; campersprogramma 22:30–00:00.
  Tijden kunnen wijzigen.
END:VEVENT
BEGIN:VEVENT
UID:bcf-saturday@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Big Church Festival — zaterdag
DTSTART;TZID=Europe/London:20260829T100000
DTEND;TZID=Europe/London:20260829T221500
LOCATION:Wiston Estate\, Steyning\, BN44 3DD
DESCRIPTION:Officieel: poorten en terrein open 10:00\, podia vanaf 12:30\
 , Main Stage klaar 22:15\; campersprogramma 22:30–00:00. Tijden kunnen
  wijzigen.
END:VEVENT
BEGIN:VEVENT
UID:pack-and-leave-bcf@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Tenten afbreken en Big Church verlaten
DTSTART;TZID=Europe/London:20260830T073000
DTEND;TZID=Europe/London:20260830T101500
LOCATION:Wiston Estate\, Steyning\, BN44 3DD
DESCRIPTION:Voorstel: om 07:30 beginnen en uiterlijk 10:15 wegrijden. Big
  Church adviseert minstens 30 minuten voor het verlaten van het terrein.
  Omdat de festivalpoorten om 10:00 openen\, wordt vrijwel de hele zondag
  gemist.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:bcf-dover-drive@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Autorit: Big Church Festival → Dover
DTSTART;TZID=Europe/London:20260830T101500
DTEND;TZID=Europe/London:20260830T122500
LOCATION:Wiston Estate\, Steyning BN44 3DD → Port of Dover Eastern Dock
 s
DESCRIPTION:Routeberekening: circa 170 km en 2 uur 8 minuten zonder stops
  of vertraging. Dit geeft ongeveer 40 minuten extra marge vóór de aanb
 evolen aankomst om 13:05 en 1 uur 40 vóór de uiterste check-in om 14:0
 5.
STATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:ferry-back@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:P&O Ferry: Dover → Calais
DTSTART;TZID=Europe/London:20260830T150500
DTEND;TZID=Europe/Paris:20260830T173500
LOCATION:Port of Dover → Port de Calais
DESCRIPTION:Boekingstijden. P&O voertuigcheck-in sluit om 14:05\, na secu
 rity\; mik vanwege grenscontrole en zomerdrukte op aankomst rond 13:05.
END:VEVENT
BEGIN:VEVENT
UID:drive-home@bcf-2026-agenda
DTSTAMP:20260816T120000Z
SUMMARY:Autorit: Calais → Apeldoorn
DTSTART;TZID=Europe/Paris:20260830T180500
DTEND;TZID=Europe/Paris:20260830T231500
LOCATION:Port de Calais → Apeldoorn
DESCRIPTION:Routeberekening: circa 391 km en 4 uur 34 minuten zonder stop
 s of vertraging. Starttijd rekent ongeveer 30 minuten voor ontschepen\; 
 eindtijd bevat circa 35 minuten pauze/buffer.
STATUS:TENTATIVE
END:VEVENT
